{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiroha Quiz",
  "version": "0.1.1",
  "identifier": "com.yiqiu.shirohaquiz.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run prepare:web", "wait": true },
    "beforeBuildCommand": "npm run prepare:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Shiroha Quiz",
      "visible": false,
      "center": true,
      "width": 1280,
      "height": 860,
      "minWidth": 900,
      "minHeight": 640,
      "dragDropEnabled": false,
      "decorations": false
    }],
    "security": {
      "capabilities": [{ "identifier": "prototype", "windows": ["main"], "permissions": [
        "allow-local-initialize",
        "allow-local-read",
        "allow-local-write",
        "allow-local-operation",
        "allow-local-checkpoint",
        "allow-local-migrate",
        "allow-local-replace",
        "allow-local-file",
        "allow-local-task", "allow-local-query", "allow-local-commit",
        "allow-service-credential", "allow-service-request",
        "allow-harness-control", "allow-harness-execute",
        "allow-codebuddy-control",
        "core:event:allow-listen", "core:event:allow-unlisten",
        "core:window:allow-start-dragging",
        "core:window:allow-minimize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-is-maximized",
        "core:window:allow-close", "core:window:allow-destroy"
      ] }],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http: https:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
