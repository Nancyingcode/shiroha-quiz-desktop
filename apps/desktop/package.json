{
  "name": "shiroha-quiz-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev --port 51736",
    "prepare:web": "node scripts/prepare-web.mjs",
    "test": "node --test test/*.test.mjs && npm run test:shared",
    "test:web-platform": "node --test ../../test/dual-platform/browser-page.cjs ../../test/dual-platform/dialog-page.cjs",
    "test:documents": "node --test ../../test/dual-platform/document-page.cjs",
    "test:shared": "node --test ../../test/dual-platform/*.test.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.platform.json",
    "lint": "eslint scripts test eslint.config.mjs eslint.platform.config.mjs && npm run lint:platform && npm run lint:docs",
    "lint:platform": "node scripts/lint-platform.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "build": "tauri build --no-bundle",
    "build:nsis": "tauri build --config src-tauri/tauri.nsis.conf.json --target x86_64-pc-windows-msvc",
    "build:offline": "tauri build --config src-tauri/tauri.offline.conf.json --target x86_64-pc-windows-msvc",
    "build:test": "npm run prepare:web && cargo build --manifest-path src-tauri/Cargo.toml --release --features custom-protocol,native-test --target-dir src-tauri/target/native-test",
    "test:desktop": "node scripts/smoke.mjs src-tauri/target/native-test/release/shiroha-quiz-desktop.exe",
    "test:dev": "node scripts/dev-smoke.mjs",
    "bench:desktop": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "playwright-core": "^1.58.0",
    "typescript": "7.0.2"
  }
}
