{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false
  },
  "include": [
    "../web/platform/**/*.js",
    "../web/platform/**/*.d.ts",
    "frontend/**/*.js",
    "frontend/**/*.ts",
    "../../test/dual-platform/*.types.ts"
  ]
}
